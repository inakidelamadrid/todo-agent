# Comma-separated list of valid API keys.
# Rotate by adding the new key, deploying, then removing the old one.
# Never commit a real key — .env is gitignored.
API_KEYS=change-me

# Telegram bot token from @BotFather. Optional; unset disables the integration.
TELEGRAM_BOT_TOKEN=

# Secret token Telegram must send in X-Telegram-Bot-Api-Secret-Token.
# 16-256 chars of A-Z a-z 0-9 _ -  Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Your numeric Telegram user ID; updates from anyone else are ignored.
# Ask @userinfobot for yours. Optional; unset disables the integration.
TELEGRAM_ALLOWED_USER_ID=

# Clerk (user login). The public key is public by design, but keep it out of git anyway.
# Dashboard → Developers → API keys → "JWKS Public Key" (PEM). Newlines may be written as \n.
CLERK_JWT_PUBLIC_KEY=
# Origins the browser app is served from, comma-separated (the token's `azp` claim).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Clerk user IDs allowed in, comma-separated. Only the owner. Looks like user_2abc…
CLERK_ALLOWED_USER_IDS=
# Clerk user IDs with admin rights (debugger playground), comma-separated.
# Admins must also be in CLERK_ALLOWED_USER_IDS to sign in at all.
ADMIN_USER_IDS=

# deployment environment: development or production.
APP_ENV=development
# Debugger playground switch. Development only: the app refuses to start
# when this is true and APP_ENV is production.
TELEGRAM_PLAYGROUND_ENABLED=false
