# Copy to .env.n8n (repo root) and replace N8N_ENCRYPTION_KEY before `make n8n-up`.
# .env.n8n is gitignored — never commit it.

# Encrypts stored credentials. Generate with: openssl rand -hex 32
# Losing this key makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=change-me

# Dates in workflows match the app's timezone.
GENERIC_TIMEZONE=America/Mexico_City
TZ=America/Mexico_City

# Local-only binding.
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http

# Needed for the login cookie over plain http://127.0.0.1.
# Production must use HTTPS and set this to true.
N8N_SECURE_COOKIE=false

# No telemetry leaves the machine.
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Code nodes cannot read container environment variables.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# Code nodes run isolated from the main process.
N8N_RUNNERS_ENABLED=true

# Settings file permissions are restricted to 0600.
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
