# Copy to web/.env.local (gitignored) and fill in before `make web-dev`.
# API_KEY must be one of the keys in api/.env (API_KEYS). It is only read by the
# Vite dev proxy and never sent to the browser bundle.
API_URL=http://127.0.0.1:8000
API_KEY=change-me

# Clerk publishable key (pk_test_… / pk_live_…): Clerk dashboard → API keys → Publishable key.
# Safe to ship in the bundle. Never put the secret key (sk_…) here.
VITE_CLERK_PUBLISHABLE_KEY=
